{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "agenticspec-render-model/1",
  "description": "One page of agenticspec-render: a graph of nodes, ports, edges, regions and marks, and panels beside it. agenticspec_render::page::render draws it as one HTML page.",
  "$ref": "#/$defs/Page",
  "$defs": {
    "Page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "title"],
      "properties": {
        "format": { "const": "agenticspec-render-model/1" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/Region" } },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/Node" } },
        "ports": { "type": "array", "items": { "$ref": "#/$defs/Port" } },
        "edges": { "type": "array", "items": { "$ref": "#/$defs/Edge" } },
        "marks": { "type": "array", "items": { "$ref": "#/$defs/Mark" } },
        "panels": { "type": "array", "items": { "$ref": "#/$defs/Panel" } },
        "groups": { "type": "array", "items": { "$ref": "#/$defs/Group" } }
      }
    },
    "Group": {
      "description": "The colour and icon of the nodes whose group is name. A group not listed keeps the palette and the plain icon.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "colour": { "$ref": "#/$defs/Colour" },
        "icon": { "$ref": "#/$defs/Icon" }
      }
    },
    "Colour": {
      "description": "A hex colour (# and 3, 4, 6 or 8 hex digits), rgb()/rgba()/hsl()/hsla() of 3 or 4 numbers (each optionally followed by % or deg, apart by spaces, commas or a slash), or one of the named colours. Anything else is refused.",
      "type": "string",
      "anyOf": [
        { "pattern": "^#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        { "pattern": "^(rgba?|hsla?)\\( *-?([0-9]+|[0-9]*\\.[0-9]+)(%|deg)?(( +| *[,/] *)-?([0-9]+|[0-9]*\\.[0-9]+)(%|deg)?){2,3} *\\)$" },
        { "enum": ["black", "white", "gray", "grey", "silver", "red", "maroon", "crimson", "tomato", "coral", "salmon", "orange", "darkorange", "gold", "yellow", "khaki", "olive", "lime", "green", "darkgreen", "forestgreen", "seagreen", "teal", "turquoise", "cyan", "aqua", "skyblue", "steelblue", "blue", "darkblue", "navy", "slateblue", "indigo", "purple", "violet", "orchid", "plum", "magenta", "fuchsia", "pink"] }
      ]
    },
    "Icon": {
      "description": "One of the icon names, drawn as that stroke icon, or a text of 1 or 2 characters drawn in the icon tile.",
      "type": "string",
      "anyOf": [
        { "enum": ["person", "bot", "bubble", "gateway", "chip", "wrench", "folder", "shield", "play", "stack", "checklist", "lock", "frame", "circle"] },
        { "minLength": 1, "maxLength": 2, "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$" }
      ]
    },
    "Region": {
      "description": "A box that holds nodes. A region whose id is a node's id is that node's card; any other outermost region is a card of its own. Its nodes are headed 'per <per>', 'in <in>' or 'in <label>'.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "in": { "type": "string" },
        "per": { "type": "string" },
        "regions": { "type": "array", "items": { "$ref": "#/$defs/Region" } }
      }
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "group"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "group": { "type": "string" },
        "badges": { "type": "array", "items": { "$ref": "#/$defs/Badge" } },
        "region": { "type": "string" }
      }
    },
    "Badge": {
      "description": "A pill at the card's top right: 'count' reads '×<value>', any other '<name> <value>'. With on: panel it is a row of the table Details under the graph instead.",
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "string" },
        "on": { "enum": ["card", "panel"], "default": "card" }
      }
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "name", "kind", "direction"],
      "properties": {
        "node": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string" },
        "direction": { "enum": ["in", "out", "both"] },
        "contract": { "type": "string" },
        "via": { "type": "string" },
        "unresolved": { "type": "boolean", "default": false }
      }
    },
    "Edge": {
      "description": "From and to name a node id, or 'node.port'. The stroke grows with count: up to 1, 2 or 3, 4 or more.",
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "label"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "label": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 }
      }
    },
    "Target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node"],
      "properties": {
        "node": { "type": "string" },
        "port": { "type": "string" }
      }
    },
    "Mark": {
      "description": "A refusal (the default) or a piece of information on a node or a port. A refusal rings its card or port.",
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "name"],
      "properties": {
        "target": { "$ref": "#/$defs/Target" },
        "name": { "type": "string" },
        "detail": { "type": "string" },
        "level": { "enum": ["info", "refusal"], "default": "refusal" }
      }
    },
    "Panel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "columns", "rows"],
      "properties": {
        "title": { "type": "string" },
        "columns": { "type": "array", "items": { "type": "string" } },
        "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
